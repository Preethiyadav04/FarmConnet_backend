# FarmConnect Backend Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=farmconnect-super-secret-development-key-replace-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# MySQL Database Settings
DB_NAME=farmconnect_db
DB_USER=root
DB_PASSWORD=your_mysql_password
